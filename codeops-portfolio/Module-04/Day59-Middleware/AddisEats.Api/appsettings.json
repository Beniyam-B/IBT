{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "Menu": {
    "DefaultPageSize": 5,
    "MaxPriceEtb": 500
  },
  "Orders": {
    "MinimumOrderEtb": 150
  }
}
